# ---------------------------------------------------------------------------
# Ledger — server-side only. Nothing in this file is ever sent to the browser.
# Copy to .env and fill in:  cp .env.example .env
# ---------------------------------------------------------------------------

# Long-lived partner bearer token (paste the accessToken from POST /partner/login).
PARTNER_ACCESS_TOKEN=

# Optional: instead of pasting a token, let the proxy log in for you and cache
# the token in memory. If both are set, PARTNER_ACCESS_TOKEN wins.
# On a 401 the proxy re-logs-in once and retries — only when these are set.
PARTNER_IDENTIFIER=
PARTNER_PASSWORD=

# Upstream API base. Only change this to point at a different environment.
MF_API_BASE=https://app2.mfapis.club/api/v2

# Port the proxy listens on. The Vite dev server proxies /api here.
PORT=8787
